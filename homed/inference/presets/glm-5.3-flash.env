# inference preset — GLM-5.3-Flash(预留档,24GB 单卡跑不下)
#
# 调研结论(2026-09-06):GLM-5.3-Flash 是 320B 总参/18B 激活的 MoE,
# 最小的 1-bit GGUF 量化就要 ~93GB,3-bit 需 128GB 内存设备——
# 它面向 DGX Spark、128GB Mac 这类大统一内存机器,不是 24GB 消费卡。
#
# 上了那类机器后再启用本档并真机校准,参考起点:
#   LARGE_MODEL_PATH=zai-org/GLM-5.3-Flash        # 或 unsloth/GLM-5.3-Flash-GGUF(走 llama.cpp)
#   LARGE_NAME=glm-5.3-flash
#   LARGE_ARGS='--max-model-len 131072 --enable-auto-tool-choice --tool-call-parser glm45'
#   (tool parser 名称以当时 vLLM 文档为准,未真机验证)
echo "GLM-5.3-Flash 是预留档: 需要 ~100GB+ 内存的设备;24GB 单卡请用 qwen3-24gb" >&2
return 1 2>/dev/null || exit 1
