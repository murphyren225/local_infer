# inference preset — Qwen3 家族 / 24GB 单卡 (RTX 4090 / 4090D / 3090)
# 2026-09-04~06 真机实测校准(显存分片 + OOM 演练后的安全余量 ~1.1GiB)。
#
# 每个模型家族一个 preset:除显存分片外,还携带该家族专属的 vLLM 参数——
# reasoning parser、工具调用解析器、思考开关。换模型的真正工作量就在这三样,
# 所以"打通一个新模型" = 新增一个 preset 文件,其他组件零改动。
LARGE_MODEL_PATH=${LARGE_MODEL_PATH:-/root/autodl-tmp/models/Qwen3-32B-AWQ}
LARGE_NAME=qwen3-32b-awq
LARGE_ARGS='--gpu-memory-utilization 0.81 --max-model-len 5120 --kv-cache-dtype fp8 --max-num-seqs 8 --max-num-batched-tokens 1024 --reasoning-parser qwen3 --default-chat-template-kwargs {"enable_thinking":false} --enable-auto-tool-choice --tool-call-parser hermes --enforce-eager'

SMALL_MODEL_PATH=${SMALL_MODEL_PATH:-/root/autodl-tmp/models/Qwen3-1.7B-FP8}
SMALL_NAME=qwen3-1.7b-fp8
SMALL_ARGS='--gpu-memory-utilization 0.11 --max-model-len 8192 --kv-cache-dtype fp8 --max-num-seqs 8 --max-num-batched-tokens 512 --reasoning-parser qwen3 --default-chat-template-kwargs {"enable_thinking":false} --enable-auto-tool-choice --tool-call-parser hermes --enforce-eager'
