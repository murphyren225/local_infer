# inference preset — CPU-only weak lane (Intel Mac, any x86 box without NVIDIA GPU)
# Engine: llama.cpp (built locally on macOS < 13.3; official binary otherwise).
# Verified on Intel i9-9880H / 16GB: 14 tok/s single stream, 1.7B Q8_0.
SMALL_ENGINE=llama.cpp
SMALL_MODEL_PATH=$MODELS/Qwen3-1.7B-Q8_0.gguf
SMALL_NAME=qwen3-1.7b-gguf
SMALL_PORT=8002
SMALL_ARGS='-c 8192 --jinja --reasoning-budget 0 --reasoning-format deepseek'
