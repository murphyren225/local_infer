# inference preset — Qwen3 家族 / 24GB 单卡 / SGLang（RadixAttention 前缀缓存 + 投机解码入口）
# 与 qwen3-24gb.env 同一硬件档，引擎换成 SGLang；参数未在真机校准，是起点不是实测值。
# 投机解码：在 LARGE_ARGS 末尾追加
#   --speculative-algorithm EAGLE3 --speculative-draft-model-path <eagle3-head> \
#   --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4
LARGE_ENGINE=sglang
LARGE_MODEL_PATH=${LARGE_MODEL_PATH:-$MODELS/Qwen3-32B-AWQ}
LARGE_NAME=qwen3-32b-awq
LARGE_PORT=8001
LARGE_ARGS='--quantization awq --context-length 8192 --mem-fraction-static 0.80 --max-running-requests 4 --tool-call-parser qwen25 --reasoning-parser qwen3 --chat-template qwen3-nothink'

SMALL_ENGINE=sglang
SMALL_MODEL_PATH=${SMALL_MODEL_PATH:-$MODELS/Qwen3-1.7B-FP8}
SMALL_NAME=qwen3-1.7b-fp8
SMALL_PORT=8002
SMALL_ARGS='--context-length 8192 --mem-fraction-static 0.12 --max-running-requests 8 --tool-call-parser qwen25 --reasoning-parser qwen3'
